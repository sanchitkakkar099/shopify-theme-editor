height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->
      <div class="body-content-wrapper">
            <a class="skip-to-content-link button visually-hidden" href="#MainContent">{{ "accessibility.skip_to_text" | t }}</a>
            {% render 'preload-screen' %}
            {% sections 'header-group' %}
            {% render 'wrapper-header' %}

            {%- if settings.layout_body == 'boxed' -%}
                <div class="wrapper-hasbanner-adv">
            {%- endif -%}
                {% render 'halo-banner-adv-left' %}
                {% render 'halo-banner-adv-right' %}
                <main id="MainContent" class="wrapper-body content-for-layout focus-none" role="main" tabindex="-1">
                    {{ content_for_layout }}
                </main>
            {%- if settings.layout_body == 'boxed' -%}
                </div>
            {%- endif -%}

            <div class="wrapper-footer">{% sections 'footer-group' %}</div>

            {% section 'halo-toolbar-mobile' %}

            <ul hidden><li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li></ul>

            {% render 'global-script-2' %}
        </div>
        {% render 'halo-popup' %}

        {%- if settings.enable_view_documentation or settings.enable_promotion -%}
            {% render 'theme-editor-notification' %}
        {%- endif -%}

        {%- if settings.use_custom_js -%}
            {{ 'custom.js' | asset_url | script_tag }}
        {%- endif -%}

        <div class="background-overlay">
            {%- if settings.show_effect_close -%}
            <div class="background-cursor-wrapper">
                <div class="background-cursor-wrapper_outer">
                    <div class="background-cursor-wrapper_inner"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20" height="20"><g class="nc-icon-wrapper" fill="#ffffff" transform="translate(0.5, 0.5)"><line fill="none" stroke-width="6" x1="46" y1="2" x2="2" y2="46"/> <line fill="none" stroke-width="6" x1="46" y1="46" x2="2" y2="2"/></g></svg></div>
                </div>
            </div>
            {%- endif -%}
        </div>

        {% render 'halo-sidebar' %}

        {%- if settings.enable_following_cursor -%}
            {% render 'cursor-fixed', style_cursor: settings.following_cursor_style %}
        {%- endif -%}

        <style>
            .menu-lv-1__action {
    padding-left: 12px !important ;
    padding-right: 12px !important ;
}
shopify-payment-terms{
margin-bottom:12px;
}
/* =========================================================
   EGARD - QUANTUS PREMIUM CONTENT SECTIONS
========================================================= */

/* Shared beige editorial background */
.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"]),
.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"]) {
  background: #f7f5f1 !important;
  overflow: hidden;
}

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__columns-wrapper,
.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__columns-wrapper {
  display: flex;
  align-items: stretch;
  min-height: 650px;
}


/* =========================================================
   1. THE CASEBACK
========================================================= */

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__column1-block {
  width: 50% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 75px 6% !important;
  box-sizing: border-box;
}


/* Product image presented as a premium object, not full bleed */
.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__column1-block img {
  display: block;
  width: 100%;
  max-width: 610px;
  height: auto;
  object-fit: contain;

  background: #fff;

  box-shadow:
    0 20px 55px rgba(0, 0, 0, 0.06);

  transition:
    transform 0.7s ease,
    box-shadow 0.7s ease;
}

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"]):hover
.hypervisual__column1-block img {
  transform: translateY(-5px);

  box-shadow:
    0 28px 70px rgba(0, 0, 0, 0.09);
}


/* CASEBACK TEXT */

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__column2-block {
  width: 50% !important;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 70px 8% 70px 2% !important;
  box-sizing: border-box;

  background: transparent !important;
}

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__text-wrapper {
  max-width: 610px;
  width: 100%;

  padding: 0 !important;

  text-align: left !important;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__text_line_one {
  position: relative;

  margin-bottom: 38px;
  padding-bottom: 23px;

  text-align: left !important;
}

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__text_line_one > div {
  font-size: 38px !important;
  line-height: 1.15;

  font-weight: 400;
  letter-spacing: 4px;

  color: #171717 !important;
}


/* Small champagne-gold divider */
.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__text_line_one::after {
  content: "";

  position: absolute;
  left: 0;
  bottom: 0;

  width: 55px;
  height: 1px;

  background: #b5965b;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__text_line_two {
  text-align: left !important;
}

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
.hypervisual__text_line_two > div {
  font-size: 17px !important;
  line-height: 1.9 !important;

  letter-spacing: 0.1px;

  color: #595650 !important;
}



/* =========================================================
   2. CURVED SAPPHIRE CRYSTAL AND CASE
========================================================= */

/*
   This section is deliberately different from CASEBACK.
   Here the photography becomes the dominant visual.
*/

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__column2-block {
  width: 52% !important;
  overflow: hidden;
  min-height: 650px;
}


/* Full photographic panel */
.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__column2-block img {
  display: block;

  width: 100%;
  height: 100%;
  min-height: 650px;

  object-fit: cover;
  object-position: center;

  transition: transform 0.9s ease;
}

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"]):hover
.hypervisual__column2-block img {
  transform: scale(1.025);
}


/* TEXT SIDE */

.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__column1-block {
  width: 48% !important;

  display: flex;
  justify-content: center;
  align-items: center;

  padding: 75px 6% 75px 8% !important;

  box-sizing: border-box;

  background: #f7f5f1 !important;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__text-wrapper {
  width: 100%;
  max-width: 590px;

  padding: 0 !important;

  text-align: left !important;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__text_line_one {
  position: relative;

  margin-bottom: 36px;
  padding-bottom: 23px;

  text-align: left !important;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__text_line_one > div {
  max-width: 520px;

  font-size: 34px !important;
  line-height: 1.25 !important;

  font-weight: 400;
  letter-spacing: 3px;

  color: #171717 !important;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__text_line_one::after {
  content: "";

  position: absolute;
  left: 0;
  bottom: 0;

  width: 55px;
  height: 1px;

  background: #b5965b;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__text_line_two {
  text-align: left !important;
}


.hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
.hypervisual__text_line_two > div {
  font-size: 16px !important;
  line-height: 1.85 !important;

  color: #595650 !important;
}



/* =========================================================
   3. BEAUTY IMAGE + TRUST / SERVICE SECTION
========================================================= */

.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"]) {
  background: #111 !important;
  overflow: hidden;
}


.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__columns-wrapper {
  display: flex;
  align-items: stretch;

  min-height: 520px;
}


/* IMAGE */

.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__column1-block {
  width: 55% !important;
  overflow: hidden;
}


.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__column1-block img {
  width: 100%;
  height: 100%;
  min-height: 520px;

  display: block;

  object-fit: cover;
  object-position: center;

  transition: transform 0.9s ease;
}


.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"]):hover
.hypervisual__column1-block img {
  transform: scale(1.025);
}


/* TRUST CONTENT */

.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__column2-block {
  width: 45% !important;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 65px 7% !important;

  box-sizing: border-box;

  background: #111 !important;
}


.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__text-wrapper {
  width: 100%;
  max-width: 520px;

  padding: 0 !important;
}


/* Remove useless empty spacing from original HTML */
.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__text_line_two > div:first-child,
.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__text_line_two > div:last-child {
  display: none;
}


/* Individual trust rows */
.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__text_line_two > div:not(:first-child):not(:last-child) {
  position: relative;

  margin: 0 !important;
  padding: 27px 0 27px 38px;

  border-bottom: 1px solid rgba(255, 255, 255, 0.14);

  font-size: 16px !important;
  line-height: 1.6 !important;

  letter-spacing: 0.3px;

  color: rgba(255,255,255,0.85) !important;
}


/* Gold check/dot */
.hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
.hypervisual__text_line_two > div:not(:first-child):not(:last-child)::before {
  content: "✓";

  position: absolute;
  left: 0;
  top: 27px;

  color: #c4a66a;

  font-size: 15px;
  font-weight: 400;
}



/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 1100px) {

  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__column1-block {
    padding: 55px 4% !important;
  }

  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__column2-block {
    padding: 55px 5% !important;
  }


  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__column1-block {
    padding: 55px 5% !important;
  }


  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__text_line_one > div,
  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__text_line_one > div {
    font-size: 30px !important;
  }

}



/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 767px) {

  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__columns-wrapper,
  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__columns-wrapper,
  .hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
  .hypervisual__columns-wrapper {
    display: flex;
    flex-direction: column;

    min-height: auto;
  }


  /* CASEBACK IMAGE */

  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__column1-block {
    width: 100% !important;

    padding: 45px 24px 20px !important;
  }


  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__column2-block {
    width: 100% !important;

    padding: 35px 24px 50px !important;
  }


  /* CURVED SAPPHIRE */

  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__column2-block {
    width: 100% !important;

    min-height: auto;

    order: 1;
  }

  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__column2-block img {
    height: 430px;
    min-height: auto;
  }


  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__column1-block {
    width: 100% !important;

    order: 2;

    padding: 45px 24px 50px !important;
  }


  /* TRUST SECTION */

  .hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
  .hypervisual__column1-block,
  .hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
  .hypervisual__column2-block {
    width: 100% !important;
  }


  .hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
  .hypervisual__column1-block img {
    height: 420px;
    min-height: auto;
  }


  .hypervisual__content-block--column-two-up:has(img[src*="quantus_Beauty"])
  .hypervisual__column2-block {
    padding: 30px 25px 40px !important;
  }


  /* COMMON MOBILE TYPOGRAPHY */

  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__text_line_one > div,
  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__text_line_one > div {
    font-size: 27px !important;
    letter-spacing: 2px;
  }


  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_V3_CASEBACK"])
  .hypervisual__text_line_two > div,
  .hypervisual__content-block--column-two-up:has(img[src*="Quantus_Upward"])
  .hypervisual__text_line_two > div {
    font-size: 15px !important;
    line-height: 1.75 !important;
  }

}
        </style>
        </body>
</html>
