{% doc %}
  @prompt
    generate on section in which top image or icons and bottom text and everything must be define settiong to manage either text or image in one row how many item show option for both desktop and mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-text-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-icon-text-grid__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-icon-text-grid__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_margin_bottom }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-icon-text-grid__items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.items_per_row_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-icon-text-grid__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.item_alignment }};
    text-align: {{ block.settings.text_alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-icon-text-grid__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_margin_bottom }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-icon-text-grid__icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icon-text-grid__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-icon-text-grid__title-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
  }

  .ai-icon-text-grid__description-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-icon-text-grid__items-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.items_per_row_mobile }}, 1fr);
    }

    .ai-icon-text-grid__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-icon-text-grid__icon-wrapper-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.8);
      height: calc({{ block.settings.icon_size }}px * 0.8);
    }
  }
{% endstyle %}

<icon-text-grid-{{ ai_gen_id }} class="ai-icon-text-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-icon-text-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-icon-text-grid__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-icon-text-grid__items-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign item_enabled_key = 'item_' | append: i | append: '_enabled'
          assign item_image_key = 'item_' | append: i | append: '_image'
          assign item_title_key = 'item_' | append: i | append: '_title'
          assign item_description_key = 'item_' | append: i | append: '_description'

          assign item_enabled = block.settings[item_enabled_key]
          assign item_image = block.settings[item_image_key]
          assign item_title = block.settings[item_title_key]
          assign item_description = block.settings[item_description_key]
        %}

        {% if item_enabled %}
          <div class="ai-icon-text-grid__item-{{ ai_gen_id }}">
            <div class="ai-icon-text-grid__icon-wrapper-{{ ai_gen_id }}">
              {% if item_image != blank %}
                <img
                  src="{{ item_image | image_url: width: 200 }}"
                  alt="{{ item_image.alt | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>

            {% if item_title != blank %}
              <h3 class="ai-icon-text-grid__title-{{ ai_gen_id }}">{{ item_title }}</h3>
            {% endif %}

            {% if item_description != blank %}
              <div class="ai-icon-text-grid__description-{{ ai_gen_id }}">{{ item_description }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</icon-text-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class IconTextGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('icon-text-grid-{{ ai_gen_id }}', IconTextGrid{{ ai_gen_id }});
  })();
</script>

